generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(cuid())
  phone            String?        @unique
  email            String?        @unique
  name             String
  password         String
  avatar           String?
  points           Int            @default(0)
  role             Role           @default(USER)
  tier             Tier           @default(BRONZE)
  lastLogin        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  googleId         String?        @unique
  notifications    Notification[]
  orders           Order[]
  reviews          Review[]
  stockChanges     StockHistory[]
  redeemedVouchers UserVoucher[]

  @@map("users")
}

model Product {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  price         Decimal        @db.Decimal(12, 0)
  oldPrice      Decimal?       @db.Decimal(12, 0)
  discount      Int?
  image         String
  images        String[]
  categoryId    String?
  brandId       String?
  description   String?
  specs         String[]
  rating        Float          @default(0)
  stock         Int            @default(0)
  lowStockAlert Int            @default(5)
  isActive      Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderItems    OrderItem[]
  brand         Brand?         @relation(fields: [brandId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  reviews       Review[]
  stockHistory  StockHistory[]

  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@map("products")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  icon     String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  images    String[]
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Banner {
  id       String  @id @default(cuid())
  image    String
  title    String
  subtitle String
  link     String
  order    Int     @default(0)
  isActive Boolean @default(true)

  @@map("banners")
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?
  content       String
  coverImage    String?
  authorName    String
  authorAvatar  String?
  category      String
  tags          String[]
  readTime      Int       @default(5)
  views         Int       @default(0)
  isPublished   Boolean   @default(false)
  publishedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
  @@map("blog_posts")
}

model Voucher {
  id            String        @id @default(cuid())
  code          String        @unique
  title         String
  description   String
  discountType  DiscountType
  discountValue Float
  pointsCost    Int
  minPurchase   Decimal       @db.Decimal(12, 0)
  maxDiscount   Decimal?      @db.Decimal(12, 0)
  expiryDate    DateTime
  isActive      Boolean       @default(true)
  image         String?
  usageLimit    Int
  usedCount     Int           @default(0)
  redeemed      UserVoucher[]

  @@map("vouchers")
}

model UserVoucher {
  id         String   @id @default(cuid())
  userId     String
  voucherId  String
  redeemedAt DateTime @default(now())
  isUsed     Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id])
  voucher    Voucher  @relation(fields: [voucherId], references: [id])

  @@unique([userId, voucherId])
  @@map("user_vouchers")
}

model Event {
  id          String     @id @default(cuid())
  title       String
  description String
  type        EventType
  rewardType  RewardType
  rewardValue Float
  conditions  Json
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean    @default(true)
  image       String?

  @@map("events")
}

model LandingPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String
  sections    Json
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_pages")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @db.Decimal(12, 0)
  address        String
  phone          String
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  discountAmount Decimal?    @db.Decimal(12, 0)
  voucherCode    String?
  voucherId      String?
  items          OrderItem[]
  user           User        @relation(fields: [userId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Decimal @db.Decimal(12, 0)
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?
  description String?
  website     String?
  hotline     String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("brands")
}

model StockHistory {
  id          String   @id @default(cuid())
  productId   String
  type        String
  quantity    Int
  previousQty Int
  newQty      Int
  reason      String?
  createdBy   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [createdBy], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("stock_history")
}

model ShippingMethod {
  id            String   @id @default(cuid())
  name          String
  description   String?
  baseCost      Decimal  @db.Decimal(12, 0)
  costPerKm     Decimal  @db.Decimal(12, 2)
  freeThreshold Decimal  @db.Decimal(12, 0)
  estimatedDays String
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("shipping_methods")
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())
  expiresAt DateTime?
  metadata  Json?
  priority  NotificationPriority @default(NORMAL)
  type      NotificationType     @default(SYSTEM)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("Guitar NOVA")
  slogan          String?
  logo            String?
  favicon         String?
  cardTitle       String?
  cardLogo        String?
  email           String?
  phone           String?
  address         String?
  facebookUrl     String?
  instagramUrl    String?
  youtubeUrl      String?
  tiktokUrl       String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  businessHours   String?
  paymentMethods  String[]
  shippingInfo    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

model PostTest {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("post_tests")
}

enum Role {
  USER
  ADMIN
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum EventType {
  LOGIN_STREAK
  PURCHASE_COUPLE
  SPECIAL_DAY
  FIRST_PURCHASE
  REFERRAL
}

enum RewardType {
  POINTS
  DISCOUNT
  VOUCHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  VOUCHER_RECEIVED
  VOUCHER_EXPIRING
  POINTS_EARNED
  TIER_UPGRADE
  PROMO
  SYSTEM
  WELCOME
  REVIEW_REMINDER
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
